# ---------------------------------------------------------------------------
# VozPilot server environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# Secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-secret-32+

# Token lifetimes (jsonwebtoken notation)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Option A (recommended for production / Supabase / managed Postgres):
# When set, embedded PostgreSQL is not started.
DATABASE_URL=postgresql://user:password@host:5432/vozpilot

# Option B (local / sandbox): embedded PostgreSQL (real PG binaries from npm).
# Used automatically when DATABASE_URL is empty.
EMBEDDED_PG_DIR=.data/postgres
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_PASSWORD=change-this-local-superuser-password
APP_DB_NAME=vozpilot
APP_DB_USER=vozpilot
APP_DB_PASSWORD=change-this-application-db-password

# ---------------------------------------------------------------------------
# OAuth 2.0 credentials (Integrations + Inbox / Schedule / Developer agents)
# Connection attempts report honest unconfigured errors until set server-side.
# Tokens are encrypted at rest and never exposed to the browser.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- VozCore engine (Phase 2 & Phase 3 orchestration) -----------------------
VOZCORE_PORT=8001

# OpenAI credentials — server-side only, never exposed to the browser.
# Without a key the engine reports vozcore_not_configured and returns clear
# configuration errors instead of simulated results.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Research Agent search provider (optional; tavily | serper | brave | custom)
# Without a configured search provider, Research Agent reports unverified
# external claims honestly instead of inventing URLs or citations.
SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# SEARCH_API_URL=

# Developer Agent sandbox limits
VOZCORE_SANDBOX_TIMEOUT=8
VOZCORE_SANDBOX_CPU_SECONDS=5
VOZCORE_SANDBOX_MEMORY_MB=256

# Optional execution limits & model pricing JSON override
# VOZCORE_MAX_TASKS=8
# VOZCORE_MAX_TASK_ATTEMPTS=2
# VOZCORE_TASK_TIMEOUT=90
# VOZCORE_EXECUTION_TIMEOUT=420
# VOZCORE_AGENT_RATE_LIMIT_PER_HOUR=60
# VOZCORE_MODEL_PRICING_JSON={"gpt-4o-mini":{"inputPer1M":0.15,"outputPer1M":0.60}}
